# ---------------------------------------------------------------------------
# rkny6.github.io — environment variables
# Copy this file to `.env` for local development.
#
# The site is deployed to GitHub Pages. The canonical origin and base path are
# hardcoded in astro.config.ts (site + base), so no SITE_URL is needed here.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Ask Box (optional)
# ---------------------------------------------------------------------------
# The Ask Box is a replaceable integration. See src/lib/askService.ts.
#
# PUBLIC_ASK_API_URL — where the browser POSTs asks. Because this value is
#   shipped to the client, it must be a PUBLIC URL: either a provider that
#   accepts browser requests directly (e.g. a Formspree form URL), or a
#   standalone proxy (see /server) that keeps real provider secrets off the
#   client. Leave it EMPTY to keep the site fully functional in demo mode —
#   asks are accepted but only logged in the browser console.
#
# Variables for the optional proxy in /server (set those on the proxy
# service, NOT on the static site):
#   ASK_TARGET_URL   — real provider endpoint the proxy forwards to.
#   ASK_API_KEY      — optional bearer/API key the proxy attaches.
#   ALLOWED_ORIGINS  — comma-separated origins allowed by CORS.
#
# Note: only variables prefixed with PUBLIC_ reach client-side code.
# Never put a secret in a PUBLIC_ variable.
PUBLIC_ASK_API_URL=
