---
import type { Locale } from '@/i18n/config';
import { LOCALE_LABELS, localizedPath, switchLangPath } from '@/i18n/config';
import { t } from '@/i18n';
import { site } from '@/data/site';

interface Props {
  lang: Locale;
  /** Pathname of this page in the other language, when one exists. */
  altLangPath?: string;
}

const { lang, altLangPath } = Astro.props;
const currentPath = Astro.url.pathname;

const NAV_ITEMS = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.blog', path: '/blog' },
  { key: 'nav.now', path: '/now', hidden: !site.features.now },
  { key: 'nav.about', path: '/about' },
  { key: 'nav.contact', path: '/contact', hidden: !site.features.contact },
] as const;

const visibleNavItems = NAV_ITEMS.filter((item) => !('hidden' in item && item.hidden));

function isActive(path: string): boolean {
  if (path === '/') return currentPath === localizedPath(lang, '/');
  const localized = localizedPath(lang, path);
  return currentPath === localized || currentPath.startsWith(`${localized}/`);
}

const otherLang = lang === 'en' ? 'zh' : 'en';
const langTarget = altLangPath ?? switchLangPath(currentPath, otherLang);
const langHref = `${langTarget}${Astro.url.search}`;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href={localizedPath(lang, '/')} class="logo" aria-label={site.title}>
      la sixième <span class="mark">nuit</span>
    </a>

    <nav class="nav-desktop" aria-label={t(lang, 'nav.menu')}>
      {visibleNavItems.map((item) => (
        <a
          href={localizedPath(lang, item.path)}
          class="nav-link"
          aria-current={isActive(item.path) ? 'page' : undefined}
        >
          {t(lang, item.key)}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a
        href={langHref}
        class="lang-switch"
        data-locale-target={otherLang}
        aria-label={t(lang, 'nav.language')}
        title={LOCALE_LABELS[otherLang]}
      >
        {LOCALE_LABELS[otherLang]}
      </a>
      <button class="theme-toggle" type="button" aria-label={t(lang, 'nav.theme')}>
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t(lang, 'nav.menu')}
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile wrap" data-open="false" aria-label={t(lang, 'nav.menu')}>
    {visibleNavItems.map((item) => (
      <a
        href={localizedPath(lang, item.path)}
        class="nav-link"
        aria-current={isActive(item.path) ? 'page' : undefined}
      >
        {t(lang, item.key)}
      </a>
    ))}
  </nav>
</header>
