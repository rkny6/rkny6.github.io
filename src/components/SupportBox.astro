const SUPPORT_LINKS = lang === 'zh'
  ? [
      {
        name: '爱发电',
        url: 'https://ifdian.net/a/rkny6',
        icon: ICONS.afdian,
      },
    ]
  : [
      {
        name: 'Ko-fi',
        url: 'https://ko-fi.com/rkny6',
        icon: ICONS.kofi,
      },
      {
        name: 'Gumroad',
        url: 'https://rkny6.gumroad.com/',
        icon: ICONS.gumroad,
      },
    ];
---

<section class="section">
  <h2>{t(lang, 'support.title')}</h2>
  <p class="muted support-note">{t(lang, 'support.intro')}</p>
  <ul class="support-list">
    {SUPPORT_LINKS.map((link) => (
      <li>
        <a href={link.url} rel="noopener noreferrer" target="_blank">
          {link.icon && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" role="img" aria-hidden="true" focusable="false">
              <path d={link.icon} />
            </svg>
          )}
          <span>{link.name}</span>
          <span class="faint">↗</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .support-note {
    margin-bottom: var(--sp-4);
  }

  .support-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .support-list a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    border: var(--border);
    padding: var(--sp-2) var(--sp-4);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .support-list a:hover {
    background: var(--accent-soft);
  }

  .support-list svg {
    flex-shrink: 0;
  }
</style>
